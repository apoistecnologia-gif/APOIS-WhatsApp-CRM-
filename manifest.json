{
  "manifest_version": 3,
  "name": "APOIS CRM",
  "version": "3.2.4",
  "description": "CRM local independente: respostas compostas, PTT, etiquetas, atendentes, funil e central multiconta.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "notifications"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "http://127.0.0.1:3210/*",
    "http://localhost:3210/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "src/wa-config.js",
        "vendor/wa-js-3.18.8.js",
        "src/whatsapp-adapter.js",
        "src/main-world.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "src/core.js",
        "src/storage.js",
        "src/diagnostics.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/logo-apois.png"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "APOIS Respostas Rápidas",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "version_name": "3.2.4 — validação real pendente"
}
